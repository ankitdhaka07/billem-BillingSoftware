<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI"
        Title="Billing App"
        Height="450"
        Width="800">

    <Window.Resources>

        <!-- Home tile button style -->
        <Style x:Key="HomeTileStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F7FF"/>
                                <Setter Property="BorderBrush" Value="#FF9BAEE0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE8ECFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VM → View mappings -->
        <DataTemplate DataType="{x:Type ui:HomeViewModel}">
            <ui:HomePage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ProductSelectionViewModel}">
            <ui:ProductSelectionPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:QuantityViewModel}">
            <ui:QuantityPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ManageItemsViewModel}">
            <ui:ManageItemsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ManageCustomersViewModel}">
            <ui:ManageCustomersPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AboutViewModel}">
            <ui:AboutPage />
        </DataTemplate>

    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
