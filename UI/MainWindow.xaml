<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI"
        Title="Billing App"
        Height="450"
        Width="800">

    <Window.Resources>
        <DataTemplate DataType="{x:Type ui:ProductSelectionViewModel}">
            <ui:ProductSelectionPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:QuantityViewModel}">
            <ui:QuantityPage />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
