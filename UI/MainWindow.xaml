<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:UI.Features.Home"
        xmlns:billing="clr-namespace:UI.Features.Billing"
        xmlns:customers="clr-namespace:UI.Features.Customers"
        xmlns:items="clr-namespace:UI.Features.Items"
        xmlns:about="clr-namespace:UI.Features.About"
        xmlns:bills="clr-namespace:UI.Features.Bills"
        xmlns:payments="clr-namespace:UI.Features.Payments"
        xmlns:ledger="clr-namespace:UI.Features.Ledger"
        xmlns:settings="clr-namespace:UI.Features.Settings"
        Title="Billem — GST Billing"
        Height="720"
        Width="1150"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>

        <!-- VM → View mappings -->
        <DataTemplate DataType="{x:Type home:HomeViewModel}">
            <home:HomePage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type billing:ProductSelectionViewModel}">
            <billing:ProductSelectionPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type billing:QuantityViewModel}">
            <billing:QuantityPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type items:ManageItemsViewModel}">
            <items:ManageItemsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type customers:ManageCustomersViewModel}">
            <customers:ManageCustomersPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type about:AboutViewModel}">
            <about:AboutPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type bills:CheckBillsViewModel}">
            <bills:CheckBillsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type bills:BillDetailsViewModel}">
            <bills:BillDetailsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type payments:PaymentsViewModel}">
            <payments:PaymentsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type payments:RecordPaymentViewModel}">
            <payments:RecordPaymentPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type payments:PaymentsListViewModel}">
            <payments:PaymentsListPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type payments:PaymentDetailsViewModel}">
            <payments:PaymentDetailsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ledger:CustomerLedgerViewModel}">
            <ledger:CustomerLedgerPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type ledger:LedgerDetailsViewModel}">
            <ledger:LedgerDetailsPage />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:CompanySettingsViewModel}">
            <settings:CompanySettingsPage />
        </DataTemplate>

    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
