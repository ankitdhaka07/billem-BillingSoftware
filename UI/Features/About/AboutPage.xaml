<UserControl x:Class="UI.Features.About.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="420">

            <Border Style="{StaticResource Card}" Padding="36" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Brand monogram -->
                    <Border Width="64" Height="64"
                            CornerRadius="18"
                            Background="{StaticResource BrandGradientBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270"
                                              Color="#6366F1" Opacity="0.35"/>
                        </Border.Effect>
                        <TextBlock Text="B"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Billem"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>

                    <Border Background="{StaticResource PrimaryTintBrush}"
                            CornerRadius="12"
                            Padding="10,4"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,20">
                        <TextBlock Text="GST BILLING SOFTWARE"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <Separator Background="{StaticResource DividerBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding CompanyName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CompanyAddress}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Content="←  Back"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Center"
                    MinWidth="110"
                    Style="{StaticResource GhostButton}"/>

        </StackPanel>
    </Grid>
</UserControl>
