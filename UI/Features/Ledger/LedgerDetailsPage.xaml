<UserControl x:Class="UI.Features.Ledger.LedgerDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,16">
                <TextBlock Text="{Binding Ledger.Customer.Name, StringFormat='Ledger · {0}'}"
                           Style="{StaticResource PageTitleText}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,4">

                    <!-- Info cards -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Customer card -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SectionAccent}" Background="#0EA5E9"/>
                                    <TextBlock Text="Customer" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Name" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Ledger.Customer.Name}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GST No." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Ledger.Customer.GstNo, TargetNullValue='URP'}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Period card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="Period" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="From" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Ledger.From, StringFormat={}{0:dd MMM yyyy}}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="To" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Ledger.To, StringFormat={}{0:dd MMM yyyy}}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Opening Balance" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Ledger.OpeningBalanceLabel}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Transactions card -->
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource SectionAccent}"
                                        Background="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Transactions" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                            </StackPanel>

                            <!-- Column headers -->
                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DATE" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="1" Text="PARTICULARS" Style="{StaticResource TableHeaderText}"/>
                                <TextBlock Grid.Column="2" Text="DEBIT (₹)" Style="{StaticResource TableHeaderText}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="CREDIT (₹)" Style="{StaticResource TableHeaderText}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="BALANCE (₹)" Style="{StaticResource TableHeaderText}" TextAlignment="Right"/>
                            </Grid>

                            <Separator Background="{StaticResource DividerBrush}" Margin="0,0,0,4"/>

                            <!-- Opening balance row -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="4,6" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Opening Balance"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Ledger.OpeningBalanceLabel}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- Rows -->
                            <ItemsControl ItemsSource="{Binding Ledger.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6,4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd-MM-yyyy}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Particulars}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DebitText, Mode=OneWay}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CreditText, Mode=OneWay}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding BalanceLabel, Mode=OneWay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty period hint -->
                            <TextBlock Text="No transactions in this period"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ledger.Rows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Separator Background="{StaticResource DividerBrush}" Margin="0,4,0,0"/>

                            <!-- Totals row -->
                            <Grid Margin="4,12,4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="TOTAL"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Ledger.PeriodDebit, StringFormat={}{0:N2}}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Ledger.PeriodCredit, StringFormat={}{0:N2}}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="4"
                                           Text="{Binding Ledger.ClosingBalanceLabel}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Closing summary banner -->
                    <Border Background="{StaticResource PrimaryTintBrush}"
                            BorderBrush="{StaticResource PrimaryTintBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,12">
                        <TextBlock Text="{Binding Ledger.ClosingSummary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="←  Back"
                        Command="{Binding BackCommand}"
                        MinWidth="100"
                        Style="{StaticResource GhostButton}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource SuccessBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,12,0"/>

                <Button Grid.Column="2"
                        Content="Generate PDF"
                        Command="{Binding GeneratePdfCommand}"
                        MinWidth="150"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
