<UserControl x:Class="UI.Features.Billing.ProductSelectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="New Bill" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Choose the customer and add products"
                               Style="{StaticResource PageSubtitleText}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Step pill -->
                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryTintBrush}"
                        BorderBrush="{StaticResource PrimaryTintBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Step 1 of 2"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </Grid>

            <!-- Content -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <!-- Customer -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource SectionAccent}"/>
                            <TextBlock Text="Customer" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                        </StackPanel>

                        <ComboBox ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  MaxWidth="380"
                                  HorizontalAlignment="Left"
                                  Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding SelectedCustomer.BillingAddress, StringFormat='Address: {0}'}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="2,0,0,24"/>

                        <!-- Available products -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource SectionAccent}"
                                    Background="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Available Products" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding AvailableItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="170"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="38"/>
                                            <TextBlock Text="{Binding Price, StringFormat=₹{0}}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Margin="0,4,0,10"/>
                                            <Button Content="+ Add"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource PillButton}"
                                                    Command="{Binding DataContext.AddItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Selected items -->
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                            <Border Style="{StaticResource SectionAccent}"
                                    Background="{StaticResource DangerBrush}"/>
                            <TextBlock Text="Selected Items" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding SelectedItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="170"
                                            Background="{StaticResource PrimaryTintBrush}"
                                            BorderBrush="{StaticResource PrimaryTintBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="14,12"
                                            Margin="0,0,10,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ItemName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="38"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=₹{0}}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       Margin="0,4,0,10"/>
                                            <Button Content="Remove"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource DangerPillButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="←  Back"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="100"
                        Style="{StaticResource GhostButton}"/>
                <Button Content="Next  →"
                        Command="{Binding NextCommand}"
                        HorizontalAlignment="Right"
                        MinWidth="130"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
