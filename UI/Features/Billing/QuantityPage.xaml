<UserControl x:Class="UI.Features.Billing.QuantityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="2,0,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Review Quantities" Style="{StaticResource PageTitleText}"/>
                    <TextBlock Text="Set the quantity for each selected item"
                               Style="{StaticResource PageSubtitleText}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryTintBrush}"
                        BorderBrush="{StaticResource PrimaryTintBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="Step 2 of 2"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </Grid>

            <!-- Content -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <!-- Column headers -->
                        <Grid Margin="14,0,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ITEM" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="QUANTITY" Style="{StaticResource TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="UNIT PRICE" Style="{StaticResource TableHeaderText}"/>
                        </Grid>

                        <!-- Items -->
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,10"
                                            Margin="0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ItemName}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBox Grid.Column="1"
                                                     Width="76"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     TextAlignment="Center"
                                                     Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding UnitPrice, StringFormat=₹{0}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="←  Back"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="100"
                        Style="{StaticResource GhostButton}"/>
                <Button Content="🧾  Generate Bill"
                        Command="{Binding GenerateBillCommand}"
                        HorizontalAlignment="Right"
                        MinWidth="160"
                        Style="{StaticResource SuccessButton}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
