<UserControl x:Class="UI.Features.Customers.ManageCustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20" Background="#FFF2F4F7">
        <Border Background="White"
                CornerRadius="12"
                Padding="20"
                Margin="10"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Customers"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#FF333333"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Add and update customer records here (coming soon)"
                           Foreground="#FF777777"/>
            </StackPanel>
        </Border>

        <Button Content="← Back"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="20,0,0,20"
                Width="100"/>
    </Grid>
</UserControl>
