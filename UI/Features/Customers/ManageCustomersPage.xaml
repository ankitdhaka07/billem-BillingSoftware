<UserControl x:Class="UI.Features.Customers.ManageCustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20" Background="#FFF2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Customers"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF333333"
                   Margin="10,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Customer List -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,12,0"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="All Customers"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF555555"
                               Margin="0,0,0,12"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#FFF0F4FF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFF8F8F8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#FF333333"/>
                                        <TextBlock Text="{Binding GstNo, TargetNullValue='No GST number'}"
                                                   FontSize="11"
                                                   Foreground="#FF999999"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Command="{Binding DataContext.DeleteCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Width="24" Height="24"
                                            FontSize="10"
                                            Foreground="#FFCC4444"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Add / Edit Form -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Customer Details"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FF555555"
                    Margin="0,0,0,16"/>
                    <!-- Name -->
                    <TextBlock Text="Name *" FontSize="12" Foreground="#FF777777" Margin="0,0,0,4"/>
                    <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 Background="Transparent"/>
                    </Border>

                    <!-- GST -->
                    <TextBlock Text="GST Number" FontSize="12" Foreground="#FF777777" Margin="0,0,0,4"/>
                    <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox Text="{Binding GstNo, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 Background="Transparent"/>
                    </Border>

                    <!-- Billing Address -->
                    <TextBlock Text="Billing Address" FontSize="12" Foreground="#FF777777" Margin="0,0,0,4"/>
                    <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                        <TextBox Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 Background="Transparent"/>
                    </Border>

                    <!-- Shipping Address -->
                    <TextBlock Text="Shipping Address" FontSize="12" Foreground="#FF777777" Margin="0,0,0,4"/>
                    <Border BorderBrush="#FFE0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                        <TextBox Text="{Binding ShippingAddress, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Padding="10,8"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 Background="Transparent"/>
                    </Border>

                    <!-- Action Buttons -->
                    <Button Content="Add Customer"
                            Command="{Binding AddCommand}"
                            Height="36"
                            FontSize="13"
                            Foreground="White"
                            Background="#FF4A6CF7"
                            BorderThickness="0"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#FFCCCCCC"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF3A5CE7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Update Customer"
                            Command="{Binding UpdateCommand}"
                            Height="36"
                            FontSize="13"
                            Foreground="White"
                            Background="#FF22A06B"
                            BorderThickness="0"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#FFCCCCCC"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF189058"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Height="36"
                            FontSize="13"
                            Foreground="#FF555555"
                            Background="#FFF2F4F7"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="12,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFE5E7EB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="← Back"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Width="100"
                Height="34"
                FontSize="13"
                Foreground="#FF555555"
                Background="#FFF2F4F7"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="12,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>