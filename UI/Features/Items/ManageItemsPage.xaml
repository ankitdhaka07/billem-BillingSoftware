<UserControl x:Class="UI.Features.Items.ManageItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="2,0,0,16">
                <TextBlock Text="Items" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Manage your product catalogue and prices"
                           Style="{StaticResource PageSubtitleText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left: item list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                            <Border Style="{StaticResource SectionAccent}"/>
                            <TextBlock Text="All Items" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                        </StackPanel>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ItemContainerStyle="{StaticResource CardListItem}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" CornerRadius="10"
                                                Background="{StaticResource ChipAmberBrush}"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="📦" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="₹"/><Run Text="{Binding Price}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Edit"
                                                Style="{StaticResource LinkButton}"
                                                Command="{Binding DataContext.SelectCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Margin="4,0"/>
                                        <Button Grid.Column="3"
                                                Content="✕"
                                                Style="{StaticResource DangerLinkButton}"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right: add / edit form -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Style="{StaticResource SectionAccent}"/>
                            <TextBlock Text="Item Details" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                        </StackPanel>

                        <TextBlock Text="Name *" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="Price (₹) *" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,20"/>

                        <Button Content="Add Item"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,8"/>

                        <Button Content="Update Item"
                                Command="{Binding UpdateCommand}"
                                Style="{StaticResource OutlineButton}"
                                Margin="0,0,0,8"/>

                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <Button Grid.Row="2"
                    Content="←  Back"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="100"
                    Margin="0,16,0,0"
                    Style="{StaticResource GhostButton}"/>
        </Grid>
    </Grid>
</UserControl>
