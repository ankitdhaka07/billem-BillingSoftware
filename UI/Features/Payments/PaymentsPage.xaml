<UserControl x:Class="UI.Features.Payments.PaymentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="440">

            <!-- Icon header -->
            <Border Width="56" Height="56"
                    CornerRadius="16"
                    Background="{StaticResource ChipEmeraldBrush}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <TextBlock Text="💰" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Payments"
                       Style="{StaticResource PageTitleText}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Record and track client payments"
                       Style="{StaticResource PageSubtitleText}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,32"/>

            <!-- Record a payment -->
            <Button Command="{Binding RecordPaymentCommand}"
                    Margin="0,0,0,12"
                    Height="80"
                    Style="{StaticResource HomeTileStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource ChipEmeraldBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="💸" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Record a Payment" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Log a new payment received from a client" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- View all payments -->
            <Button Command="{Binding ViewPaymentsCommand}"
                    Margin="0,0,0,20"
                    Height="80"
                    Style="{StaticResource HomeTileStyle}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12"
                            Background="{StaticResource ChipVioletBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="📜" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="View All Payments" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Browse and filter all recorded transactions" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Button>

            <!-- Back -->
            <Button Command="{Binding BackCommand}"
                    Content="←  Back to Home"
                    HorizontalAlignment="Center"
                    MinWidth="150"
                    Style="{StaticResource GhostButton}"/>

        </StackPanel>
    </Grid>
</UserControl>
