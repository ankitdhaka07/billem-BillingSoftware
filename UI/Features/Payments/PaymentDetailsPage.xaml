<UserControl x:Class="UI.Features.Payments.PaymentDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20" Background="#FFF2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Payment Details"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF333333"
                   Margin="10,0,0,16"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Payment Info Card -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="16"
                        BorderBrush="#FFE0E0E0"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Payment"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF555555"
                                   Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Amount" FontSize="12" Foreground="#FF888888"/>
                            <TextBlock Grid.Column="1"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FF22A06B">
                                <Run Text="₹"/>
                                <Run Text="{Binding AmountPaid, Mode=OneWay, StringFormat={}{0:N2}}"/>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Date" FontSize="12" Foreground="#FF888888"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PaymentDate, StringFormat={}{0:dd MMM yyyy}}"
                                       FontSize="12"
                                       Foreground="#FF333333"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Customer Info Card -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="16"
                        BorderBrush="#FFE0E0E0"
                        BorderThickness="1"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Customer"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF555555"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name" FontSize="12" Foreground="#FF888888"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CustomerName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FF333333"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="← Back to Payments"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Width="150"
                Height="34"
                FontSize="13"
                Foreground="#FF555555"
                Background="#FFF2F4F7"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="12,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
