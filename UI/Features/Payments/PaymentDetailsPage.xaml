<UserControl x:Class="UI.Features.Payments.PaymentDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="2,0,0,16">
                <TextBlock Text="Payment Details" Style="{StaticResource PageTitleText}"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Payment info card -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource SectionAccent}"
                                        Background="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="Payment" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                            </StackPanel>

                            <!-- Amount hero -->
                            <Border Background="{StaticResource SuccessTintBrush}"
                                    CornerRadius="12"
                                    Padding="16,12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="AMOUNT RECEIVED" Style="{StaticResource TableHeaderText}"/>
                                    <TextBlock FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Margin="0,4,0,0">
                                        <Run Text="₹"/><Run Text="{Binding AmountPaid, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Date" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding PaymentDate, StringFormat={}{0:dd MMM yyyy}}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Customer info card -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource SectionAccent}" Background="#0EA5E9"/>
                                <TextBlock Text="Customer" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CustomerName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Button Grid.Row="2"
                    Content="←  Back to Payments"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="160"
                    Margin="0,16,0,0"
                    Style="{StaticResource GhostButton}"/>
        </Grid>
    </Grid>
</UserControl>
