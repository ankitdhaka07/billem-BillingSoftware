<UserControl x:Class="UI.Features.Payments.RecordPaymentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20" Background="#FFF2F4F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Record a Payment"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#FF333333"
                   Margin="10,0,0,16"/>

        <!-- Form Card -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="24"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="380">
            <StackPanel>

                <TextBlock Text="Payment Details"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#FF555555"
                           Margin="0,0,0,20"/>

                <!-- Customer -->
                <TextBlock Text="Customer"
                           FontSize="12"
                           Foreground="#FF555555"
                           Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          DisplayMemberPath="Name"
                          Height="34"
                          Margin="0,0,0,16"
                          FontSize="13"
                          Padding="10,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Border Background="White"
                                                BorderBrush="#FFE0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <ToggleButton x:Name="ToggleButton"
                                                              Background="Transparent"
                                                              BorderThickness="0"
                                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}, Mode=TwoWay}"
                                                              ClickMode="Press"
                                                              Focusable="False"/>
                                                <ContentPresenter x:Name="ContentSite"
                                                                  IsHitTestVisible="False"
                                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                  Margin="10,0,28,0"
                                                                  VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Placeholder"
                                                           Text="Select customer..."
                                                           FontSize="13"
                                                           Foreground="#FFAAAAAA"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Visibility="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}, Converter={x:Null}}"/>
                                                <Path x:Name="Arrow"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#FF777777"/>
                                                <Popup x:Name="Popup"
                                                       Placement="Bottom"
                                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                                       AllowsTransparency="True"
                                                       Focusable="False"
                                                       PopupAnimation="Slide">
                                                    <Border Background="White"
                                                            BorderBrush="#FFE0E0E0"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            MinWidth="{TemplateBinding ActualWidth}"
                                                            MaxHeight="200">
                                                        <ScrollViewer>
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- Amount -->
                <TextBlock Text="Amount (₹)"
                           FontSize="12"
                           Foreground="#FF555555"
                           Margin="0,0,0,6"/>
                <Border Background="White"
                        BorderBrush="#FFE0E0E0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,16">
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,8"
                             FontSize="13"
                             Foreground="#FF333333"/>
                </Border>

                <!-- Payment Date -->
                <TextBlock Text="Payment Date"
                           FontSize="12"
                           Foreground="#FF555555"
                           Margin="0,0,0,6"/>
                <DatePicker SelectedDate="{Binding PaymentDate}"
                            Height="34"
                            Margin="0,0,0,24"
                            FontSize="13"
                            BorderBrush="#FFE0E0E0"
                            BorderThickness="1"/>

                <!-- Save Button -->
                <Button Content="Save Payment"
                        Command="{Binding SaveCommand}"
                        Height="38"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF22A06B"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF1A8F5C"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#FFCCCCCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2"
                Content="← Cancel"
                Command="{Binding CancelCommand}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Width="100"
                Height="34"
                FontSize="13"
                Foreground="#FF555555"
                Background="#FFF2F4F7"
                BorderThickness="0">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="12,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFE5E7EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
