<UserControl x:Class="UI.Features.Payments.RecordPaymentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="2,0,0,16">
                <TextBlock Text="Record a Payment" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="Log a payment received from a client"
                           Style="{StaticResource PageSubtitleText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form card -->
            <Border Grid.Row="1"
                    Style="{StaticResource Card}"
                    Padding="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="400">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Style="{StaticResource SectionAccent}"
                                Background="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="Payment Details" Style="{StaticResource SectionHeaderText}" Margin="0"/>
                    </StackPanel>

                    <!-- Customer -->
                    <TextBlock Text="Customer" Style="{StaticResource FieldLabelText}"/>
                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,14"/>

                    <!-- Amount -->
                    <TextBlock Text="Amount (₹)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14"/>

                    <!-- Payment date -->
                    <TextBlock Text="Payment Date" Style="{StaticResource FieldLabelText}"/>
                    <DatePicker SelectedDate="{Binding PaymentDate}"
                                Margin="0,0,0,24"/>

                    <!-- Save -->
                    <Button Content="Save Payment"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource SuccessButton}"/>

                </StackPanel>
            </Border>

            <!-- Footer -->
            <Button Grid.Row="2"
                    Content="←  Cancel"
                    Command="{Binding CancelCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="100"
                    Margin="0,16,0,0"
                    Style="{StaticResource GhostButton}"/>
        </Grid>
    </Grid>
</UserControl>
